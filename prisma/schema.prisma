generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  role         String   @default("admin") // "admin" | "analyst"
  passwordHash String
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  auditLogs    AuditLog[]
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String
  userRole  String
  action    String   // "login" | "logout" | "create" | "update" | "delete" | "status_change"
  section   String   // "blogs" | "testimonials" | "leads" | "site-content" | "users" | etc.
  targetId  String?
  summary   String
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userEmail])
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String
  category    String   @default("Blog")
  author      String?
  coverImage  String?
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Webinar {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String?
  content      String?
  speaker      String?
  speakerTitle String?
  speakerImage String?
  videoUrl     String?
  coverImage   String?
  date         DateTime?
  duration     String?
  published    Boolean  @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model CaseStudy {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String?
  schoolName  String?
  location    String?
  board       String?
  coverImage  String?
  stats       String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NewsEvent {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String?
  category    String   @default("News")
  eventDate   DateTime?
  location    String?
  coverImage  String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HelpDoc {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String
  category    String   @default("Getting Started")
  order       Int      @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ReleaseNote {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  version     String
  content     String
  releaseDate DateTime?
  type        String   @default("Feature")
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FeaturePage {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  headline    String?
  description String?
  content     String?
  icon        String?
  benefits    String?
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SolutionPage {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  boardName   String
  headline    String?
  description String?
  content     String?
  features    String?
  coverImage  String?
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id          String   @id @default(cuid())
  name        String
  role        String?
  school      String?
  content     String
  rating      Int      @default(5)
  order       Int      @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FAQ {
  id          String   @id @default(cuid())
  question    String
  answer      String
  category    String   @default("General")
  order       Int      @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  institution String?
  numberOfStudents String?
  city      String?
  currentSoftware String?
  subject   String?
  message   String?
  status    String   @default("new")
  source    String   @default("contact_form") // "contact_form" | "whatsapp"
  createdAt DateTime @default(now())
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  section   String
  label     String
  type      String   @default("text")
  order     Int      @default(0)
  updatedAt DateTime @updatedAt
}
