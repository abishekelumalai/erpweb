# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local SQLite database — contains real contact submissions, password hashes,
# audit logs. Never commit; production DB lives on the host's persistent disk.
/db/*.db
/db/*.db-journal
prisma/db/*.db
prisma/db/*.db-journal
prisma/db/*.bak_*
*.db.bak_*

# runtime/scratch artifacts — not part of the deployable app
.zscripts/*.pid
tool-results/

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/